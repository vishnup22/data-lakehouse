AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=lakehouse
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TOPIC=raw_events
RAW_TABLE_PATH=s3a://lakehouse/raw/events
CHECKPOINT_PATH=s3a://lakehouse/checkpoints/raw_events
QUARANTINE_TABLE_PATH=s3a://lakehouse/quarantine/events
DELTA_TABLE_PATH=s3a://lakehouse/raw/events
DELTA_CHECKPOINT_PATH=s3a://lakehouse/checkpoints/raw_events
SPARK_MASTER=local[*]
SPARK_APP_NAME=lakehouse-compaction
COMPACTION_INTERVAL_SECONDS=3600
SMALL_FILE_THRESHOLD_MB=32
TARGET_FILE_SIZE_MB=128
SMALL_FILE_COUNT_THRESHOLD=20
PARTITION_FILE_COUNT_THRESHOLD=100
PARTITION_AGE_SKIP_MINUTES=30
LOCK_TIMEOUT_SECONDS=3600
LOCK_BASE_PATH=locks/compaction
USE_DELTA_OPTIMIZE=false
METRICS_PATH=logs/compaction_metrics.jsonl
LOG_JSON_FORMAT=true
PRODUCER_EVENTS_PER_SECOND=50
PRODUCER_BATCH_SIZE=100
BAD_EVENT_RATE=0.02
QUALITY_METRICS_PATH=logs/quality_metrics.jsonl
BENCHMARK_USE_DUCKDB=true
BENCHMARK_RESULTS_PATH=logs/benchmark_results.jsonl
BENCHMARK_REPORT_PATH=logs/benchmark_report.md
